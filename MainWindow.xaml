<Window x:Class="DGKNInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DGKNInspector.Views"
        Title="DGKN@Labs inspector"
        Height="760" Width="1280" MinHeight="520" MinWidth="960"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Kopfzeile ===== -->
        <Grid Grid.Row="0" Margin="4,0,4,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource Accent}" CornerRadius="10" Width="40" Height="40">
                    <TextBlock Text="🔍" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="inspector" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="SubtitleText" Text="DGKN@Labs · Installierte Programme · Herkunft &amp; Signatur"
                               FontSize="12" Foreground="{StaticResource Secondary}" Margin="0,-2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Tab-Umschalter -->
            <Border Grid.Column="1" Background="{StaticResource Border}" CornerRadius="10" Padding="3"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabPrograms" Style="{StaticResource TabSwitch}" GroupName="Tabs"
                                 Content="📦  Programme" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabNetwork" Style="{StaticResource TabSwitch}" GroupName="Tabs"
                                 Content="🌐  Netzwerk" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="AdminButton" Style="{StaticResource PillButton}" Height="34"
                        Content="🛡 Als Admin" Click="Admin_Click" Margin="0,0,18,0"
                        ToolTip="Neu starten mit Administratorrechten – zeigt Pfade und Signaturen aller Prozesse."/>
                <TextBlock x:Name="CountText" Text="—" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="120">
                    <TextBlock x:Name="CountLabelText" Text="Programme" FontSize="11" Foreground="{StaticResource Secondary}"/>
                    <TextBlock x:Name="ProgressText" Text="" FontSize="11" Foreground="{StaticResource Secondary}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== Ansichten ===== -->
        <Grid Grid.Row="1">
            <views:ProgramsView x:Name="ProgramsView"/>
            <views:NetworkView x:Name="NetworkView" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
