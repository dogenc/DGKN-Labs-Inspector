<UserControl x:Class="DGKNInspector.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Height="34">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchHint" Text="Suche: Prozess, IP, Land, Port…"
                           Foreground="{StaticResource Secondary}" FontSize="13"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <WrapPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <ToggleButton x:Name="ExternalOnly" Style="{StaticResource Toggle}" Height="34"
                              Content="Nur externe" IsChecked="True" Click="Filter_Changed"/>
                <ToggleButton x:Name="HideListening" Style="{StaticResource Toggle}" Height="34" Margin="8,0,0,0"
                              Content="Lauscher ausblenden" Click="Filter_Changed"/>
                <ToggleButton x:Name="ProblemsOnly" Style="{StaticResource Toggle}" Height="34" Margin="8,0,0,0"
                              Content="Nur Auffällige" Click="Filter_Changed"
                              ToolTip="Nur Verbindungen von unsignierten oder ungültig signierten Prozessen."/>
                <ToggleButton x:Name="GeoEnabled" Style="{StaticResource Toggle}" Height="34" Margin="8,0,0,0"
                              Content="🌍 Länderabfrage" IsChecked="False" Click="Geo_Toggled"
                              ToolTip="Sendet öffentliche Remote-IPs an ip-api.com, um Land und Provider zu ermitteln. Standardmäßig aus."/>
                <ToggleButton x:Name="AutoRefresh" Style="{StaticResource Toggle}" Height="34" Margin="8,0,0,0"
                              Content="Auto (5s)" IsChecked="True" Click="Auto_Toggled"/>
            </WrapPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PillButton}" Height="34"
                        Content="⇩ CSV" Click="Export_Click" Margin="0,0,8,0"
                        ToolTip="Aktuelle (gefilterte) Liste als CSV speichern."/>
                <Button Style="{StaticResource AccentButton}" Height="34"
                        Content="Aktualisieren" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Tabelle -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <DataGrid x:Name="Table" Style="{StaticResource Table}" RowHeight="52"
                          MouseDoubleClick="Table_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PROZESS" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProcessFolder}" FontSize="11"
                                                   Foreground="{StaticResource Secondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ProcessPath}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SIGNATUR" Width="160" CellTemplate="{StaticResource SignatureCell}"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="72"/>
                        <DataGridTextColumn Header="PROTOKOLL" Binding="{Binding Protocol}" Width="90"/>
                        <DataGridTextColumn Header="LOKAL" Binding="{Binding Local}" Width="170"/>
                        <DataGridTextColumn Header="REMOTE" Binding="{Binding Remote}" Width="180"/>
                        <DataGridTemplateColumn Header="HERKUNFT" Width="170" CellTemplate="{StaticResource CountryCell}"/>
                        <DataGridTextColumn Header="PROVIDER" Binding="{Binding Isp}" Width="*" MinWidth="120"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding State}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyText" Text="Wird geladen…" Foreground="{StaticResource Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Statusleiste -->
        <Grid Grid.Row="2" Margin="4,12,4,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Secondary}" FontSize="11"
                       VerticalAlignment="Center"
                       Text="Doppelklick auf eine Zeile öffnet den Programmordner."/>
            <TextBlock x:Name="GeoHint" HorizontalAlignment="Right" Foreground="{StaticResource Secondary}" FontSize="11"
                       Text="Länderabfrage aus · keine Daten verlassen den PC"/>
        </Grid>
    </Grid>
</UserControl>
